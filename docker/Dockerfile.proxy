# ==============================================================================
# Multi-stage Dockerfile for High-Performance C++20 Reverse Proxy
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build Environment
# ------------------------------------------------------------------------------
FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

# Install modern C++20 toolchain, CMake, and build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ninja-build \
    gcc-12 \
    g++-12 \
    git \
    ca-certificates \
    && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-12 100 \
       --slave /usr/bin/g++ g++ /usr/bin/g++-12 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy all source files and CMake configuration
COPY . .

# Configure and compile project in Release mode
RUN cmake -B build -S . -DCMAKE_BUILD_TYPE=Release -G Ninja && \
    cmake --build build --config Release

# Locate the compiled proxy binary and stage it
RUN cp /app/build/proxy /app/proxy_bin

# ------------------------------------------------------------------------------
# Stage 2: Minimal Runtime Environment
# ------------------------------------------------------------------------------
FROM ubuntu:22.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive

# Install essential runtime libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libstdc++6 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the compiled binary from the builder stage
COPY --from=builder /app/proxy_bin /app/proxy
RUN chmod +x /app/proxy

# Expose reverse proxy listening port
EXPOSE 8080

# Default execution command: listen on 8080 and forward to backend-1:9001
CMD ["/app/proxy", "--port", "8080", "--backend", "backend-1:9001"]
